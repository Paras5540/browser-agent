# Browser Agent — nginx reverse proxy
# /etc/nginx/sites-available/browser-agent
# deploy.sh isko __DOMAIN__ replace karke install karta hai.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    # Agent kabhi bada output/CSV bhej sakta hai
    client_max_body_size 20m;

    # Long tasks: ek run me minutes lag sakte hain
    proxy_connect_timeout 60s;
    proxy_send_timeout    600s;
    proxy_read_timeout    600s;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # polling / future SSE ke liye
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
    }

    access_log /var/log/nginx/browser-agent.access.log;
    error_log  /var/log/nginx/browser-agent.error.log;
}
