# ── Copy this file to .env and fill in your values ────────────────────────────

# Gemini API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_KEY_HERE

# Model. gemini-2.5-flash is fast + cheap. Try gemini-2.5-pro for harder tasks.
GEMINI_MODEL=gemini-2.5-flash

# Server port
PORT=3000

# Run the browser invisibly? true = background, false = you can watch it work.
HEADLESS=true

# Max tool-steps per task. Raise for long multi-page jobs.
MAX_STEPS=45

# Where the persistent browser profile lives (logins/cookies survive restarts).
USER_DATA_DIR=./data/browser-profile

# Optional: simple password gate for the dashboard. Leave empty to disable.
DASHBOARD_PASSWORD=

# Bind address. Use 127.0.0.1 when running behind nginx/Caddy (recommended on a VPS).
HOST=0.0.0.0
